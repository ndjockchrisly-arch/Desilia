# Variables d'environnement pour le déploiement Vercel & AI Studio
# Configurez ces variables dans les paramètres Vercel : Settings > Environment Variables

# Clé API Google Gemini (optionnelle pour le build, requise si des fonctionnalités IA sont activées)
GEMINI_API_KEY=votre_cle_gemini_ici
VITE_GEMINI_API_KEY=votre_cle_gemini_ici
